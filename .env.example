# Copy to .env and fill in what you use. Read by docker compose (the container gets these as environment variables).
# Keep .env out of git: it holds secrets. Every variable is documented in the README (Configuration).

# Public address of the server: the base of the OAuth callback URLs. For this machine it is the port compose publishes.
# On a server, use its https address instead (https://timeline.example.com).
PUBLIC_URL=http://localhost:4310

# Sign-in with GitHub (a GitHub App or an OAuth App) and with GitLab. Leave a pair empty to turn that sign-in off:
# a placeholder value would show the button and fail. Callbacks: <PUBLIC_URL>/api/oauth/github/callback and
# <PUBLIC_URL>/api/oauth/gitlab/callback, registered on the host's app with the same address.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# The server's own access to the hosts (there is no gh or glab session inside the container). Optional, but a
# GitLab repo needs one of these or a sign-in: a personal access token with the api scope (read_api to only read).
# The token is a secret: keep it in .env only.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Extra host names the server answers to, comma-separated (e.g. the name your proxy serves it under). Optional.
ALLOWED_HOSTS=

# Optional: webhook secret, sync interval in minutes, days of CI kept.
# WEBHOOK_SECRET=
# POLL_MINUTES=5
# CI_DAYS=90
